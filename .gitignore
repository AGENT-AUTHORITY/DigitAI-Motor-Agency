# build
dist/
.astro/

# deps
node_modules/

# env — nunca commitear IDs ni secrets
.env
.env.production
.env.local
*.local

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# logs
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# originales de assets. Se ignora el contenido pesado, pero los fuentes de
# texto SI se versionan: sin ellos no se puede regenerar la social card ni los
# iconos de forma consistente. Se usa "assets-source/*" y no "assets-source/",
# porque una negacion no puede reactivar nada si el directorio entero esta
# excluido: git ni siquiera lo recorre.
assets-source/*
!assets-source/README.md
!assets-source/*.svg
!assets-source/*.html

# Los PNG fuente de los heroes de service page SI se versionan, aunque pesen:
# son el origen de los derivados WebP que sirve el sitio y sin ellos un clon
# nuevo no puede regenerarlos. Vivian en public/assets/service-heroes/, donde
# Astro los copiaba al build — 9,6 MB publicados que ningun documento pedia.
!assets-source/service-heroes/

# Capturas de QA: artefactos de revision, no fuente
qa-screens/

# Estado de ejecucion de impeccable live mode: journal de sesiones, raices
# resueltas y registro de inyeccion. La configuracion (.impeccable/config.json
# y .impeccable/live/config.json) SI se versiona: define como se levanta el
# modo live en este proyecto.
.impeccable/live/sessions/
.impeccable/live/roots.json
.impeccable/live/inject-journal.json
