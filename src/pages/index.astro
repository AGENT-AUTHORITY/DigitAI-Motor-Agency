---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import HeroSystem from '../components/HeroSystem.astro';
import GrowthFlow from '../components/GrowthFlow.astro';
import ProcessFlow from '../components/ProcessFlow.astro';
import CreativeFlow from '../components/CreativeFlow.astro';
import CapabilityGrid from '../components/CapabilityGrid.astro';
import EvidenceCase from '../components/EvidenceCase.astro';
import QuickFixMatrix from '../components/QuickFixMatrix.astro';
import FounderNote from '../components/FounderNote.astro';
import FAQ from '../components/FAQ.astro';
import ContactIntent from '../components/ContactIntent.astro';
import Button from '../components/Button.astro';
import { ANCHORS, LINKEDIN_URL, SITE } from '../data/navigation';

// Todo el copy sale de docs/COPY.md. Ninguna cifra fuera de docs/COPY.md.
const site = Astro.site ?? new URL('https://www.digitaimotor.lat');

const growthNodes = [
  { label: 'TRAFFIC', note: 'Tráfico incorrecto' },
  { label: 'CREATIVE', note: 'Mensaje débil' },
  { label: 'LANDING', note: 'Se pierde intención' },
  { label: 'LEAD', note: 'Baja calidad' },
  { label: 'SALES', note: 'Seguimiento lento' },
  { label: 'REVENUE', note: 'Venta desconocida' },
  { label: 'DATA', note: 'Atribución rota' },
];

const processSteps = [
  {
    number: '01',
    title: 'Diagnose',
    description: 'El cuello de botella real, no el más visible.',
    detail: [
      'Negocio', 'Mercado', 'Oferta', 'Cliente', 'Competencia',
      'Ads', 'Creative', 'Landing', 'Funnel', 'Proceso comercial',
    ],
  },
  { number: '02', title: 'Prioritize', description: 'Impacto potencial por encima de trabajo cosmético.' },
  { number: '03', title: 'Test', description: 'Hipótesis convertidas en experimentos legibles.' },
  { number: '04', title: 'Learn', description: 'Leer las señales, también las negativas.' },
  { number: '05', title: 'Scale', description: 'Escalar solo lo que ya demostró valor.' },
];

const capabilities = [
  {
    problem: '¿Estás pagando por tráfico que no debería llegar?',
    title: 'Paid Media',
    answer: 'Encontramos dónde se está desperdiciando adquisición.',
    items: ['Google Ads', 'Meta Ads', 'Search', 'Remarketing', 'Auditoría de campañas'],
    href: '/paid-media/',
  },
  {
    problem: '¿Llega el tráfico pero la página no cierra?',
    title: 'CRO & Conversion',
    answer: 'Encontramos dónde se pierde la intención.',
    items: ['Landing pages', 'Oferta', 'Formularios', 'WhatsApp', 'Mobile UX', 'Flujo de leads'],
    href: '/cro-landing-pages/',
  },
  {
    problem: '¿Entran leads pero no sabés cuáles terminaron vendiendo?',
    title: 'Revenue Systems',
    answer: 'Conectamos adquisición con ventas.',
    items: ['Tracking', 'Analytics', 'CRM', 'Atribución', 'Seguimiento', 'Automatización'],
    // Revenue Systems no tiene pagina propia. ROUTES.md registra que
    // /tracking-analytics/ "se cubre hoy dentro de Growth Audit": es el destino
    // documentado, no una aproximacion inventada.
    href: '/growth-audit/',
  },
  {
    problem: '¿El problema está fuera del Ads Manager?',
    title: 'Growth Engineering',
    answer: 'Construimos la conexión que falta.',
    items: ['Dashboards', 'Herramientas internas', 'APIs', 'CRMs', 'Automatización', 'AI workflows'],
    href: '/growth-engineering/',
  },
];

const quickFixItems = [
  'Google Ads', 'Meta Ads', 'Meta Business', 'GA4', 'GTM', 'Pixel',
  'Conversion Tracking', 'Landing', 'Forms', 'WhatsApp', 'CRM',
  'Search Console', 'Technical SEO', 'Automation', 'API', 'Dashboard',
];

const faqs = [
  {
    question: '¿Trabajan solamente con empresas grandes?',
    answer:
      'No. Se puede empezar por un problema puntual, una auditoría, una implementación acotada o una relación continua como Growth Partner. El alcance lo define el cuello de botella, no el tamaño de la empresa.',
  },
  {
    question: '¿Pueden revisar campañas que ya están activas?',
    answer:
      'Sí. Primero diagnóstico, después cambios. Tocar una cuenta activa sin entender qué está midiendo suele empeorar el resultado antes de mejorarlo.',
  },
  {
    question: '¿Trabajan solamente con Google Ads y Meta Ads?',
    answer:
      'No. Paid Media es solo una parte del sistema. El rendimiento también se pierde en el mensaje, la landing, el seguimiento comercial y la medición.',
  },
  {
    question: '¿También desarrollan landing pages, CRM o automatizaciones?',
    answer:
      'Sí, cuando el cuello de botella lo requiere. El desarrollo existe al servicio del crecimiento: no construimos software por construir software.',
  },
  {
    question: '¿Trabajan fuera de Argentina?',
    answer:
      'Sí. El trabajo es remoto con toda LATAM y hay posibilidad de proyectos internacionales.',
  },
];

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'digitAI Motor',
  alternateName: 'digitAI motor',
  url: site.href,
  logo: new URL('/assets/logo-mark.svg', site).href,
  description:
    'Growth Partner. Paid Media, Performance Creative, CRO, tracking y sistemas comerciales conectados desde el tráfico hasta la venta.',
  founder: { '@type': 'Person', name: 'Oscar Chinchilla', sameAs: LINKEDIN_URL },
  sameAs: [LINKEDIN_URL],
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.locality,
    addressRegion: SITE.region,
    addressCountry: 'AR',
  },
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'digitAI Motor',
  url: site.href,
  description:
    'Diagnóstico y ejecución de crecimiento: Paid Media, Performance Creative, CRO, tracking, CRM y automatización.',
  areaServed: [
    { '@type': 'Country', name: 'Argentina' },
    { '@type': 'Place', name: 'LATAM' },
  ],
  knowsAbout: [
    'Performance Marketing', 'Google Ads', 'Meta Ads', 'Performance Creative',
    'Conversion Rate Optimization', 'Web Analytics', 'Marketing Attribution',
    'CRM', 'Marketing Automation',
  ],
};
---

<BaseLayout
  title="Growth Partner | Performance, Creative & CRO | digitAI Motor"
  description="Paid Media, Performance Creative, CRO, tracking y automatización conectados desde el tráfico hasta la venta. Primero encontramos qué frena el crecimiento."
  schema={[organizationSchema, serviceSchema]}
>
  <!-- 01 · HERO -->
  <Hero
    eyebrow="Growth Partner · Performance · Creative"
    title={[
      'Encontramos qué está frenando tu crecimiento.',
      'Después lo arreglamos.',
    ]}
    subtitle="Paid Media, Performance Creative, CRO, tracking y sistemas comerciales conectados desde el tráfico hasta la venta."
    supporting="Ads are only one part of growth."
    primaryCta={{
      label: 'Solicitar diagnóstico de crecimiento',
      href: ANCHORS.growthAudit,
      trackingEvent: 'growth_audit_click',
    }}
    secondaryCta={{
      label: 'Tengo un problema puntual',
      href: ANCHORS.quickFix,
      trackingEvent: 'quick_fix_click',
    }}
    capabilities={[
      'Paid Media',
      'Performance Creative',
      'CRO',
      'Tracking',
      'CRM',
      'Growth Engineering',
    ]}
  >
    <HeroSystem slot="media" />
  </Hero>

  <!-- 02 · WHERE GROWTH BREAKS -->
  <section class="section section--alt section--tight-top" aria-labelledby="breaks-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow eyebrow--dot">Where growth breaks</p>
        <h2 id="breaks-title">Tu problema de crecimiento no siempre es un problema de Ads.</h2>
        <p class="section-head__lead">
          El rendimiento puede perderse en cualquier punto entre el tráfico y la venta.
        </p>
      </div>

      <GrowthFlow nodes={growthNodes} />

      <p class="closing-line">
        Primero encontramos dónde se rompe. Después decidimos qué tocar.
      </p>
    </div>
  </section>

  <!-- 03 · OUR GROWTH SYSTEM -->
  <section class="section" aria-labelledby="system-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow eyebrow--dot">How we work</p>
        <h2 id="system-title">
          No empezamos optimizando.<br />Empezamos entendiendo.
        </h2>
      </div>

      <ProcessFlow steps={processSteps} />
    </div>
  </section>

  <!-- 04 · PERFORMANCE CREATIVE -->
  <section
    class="section section--alt creative-section"
    id="performance-creative"
    aria-labelledby="creative-title"
  >
    <div class="container">
      <div class="section-head creative-section__head">
        <p class="eyebrow eyebrow--dot">Performance Creative</p>
        <p class="creative-section__kicker">Creative isn't decoration. It's performance.</p>
        <h2 id="creative-title">
          Tu próximo ganador puede estar escondido en los datos que ya tenés.
        </h2>
        <p class="section-head__lead">
          Convertimos insights, hooks y conceptos en hipótesis que se pueden testear.
        </p>
      </div>

      <CreativeFlow />

      <div class="creative-section__cta">
        {/* Mientras /performance-creative/ no exista, el CTA describe la
            accion real (pedir un analisis) y no una navegacion que no ocurre.
            Vuelve a "Explorar Performance Creative" en FASE 4/5. Ver ROUTES.md */}
        <Button
          label="Solicitar análisis creativo"
          href={ANCHORS.growthAudit}
          variant="secondary"
          arrow
          trackingEvent="performance_creative_view"
          trackingContext="creative_section"
        />
      </div>
    </div>
  </section>

  <!-- 05 · CAPABILITIES -->
  <section class="section" id="capabilities" aria-labelledby="caps-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow eyebrow--dot">Capabilities</p>
        <h2 id="caps-title">Dónde podemos intervenir.</h2>
        <p class="section-head__lead">
          No hace falta contratar todo. Hace falta saber cuál frente está frenando el resultado.
        </p>
      </div>

      <CapabilityGrid capabilities={capabilities} />
    </div>
  </section>

  <!-- 06 · EVIDENCE -->
  <section class="section section--alt" id="evidence" aria-labelledby="evidence-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow eyebrow--dot">Evidence, not claims</p>
        <h2 id="evidence-title">Un análisis vale más cuando termina en una decisión.</h2>
      </div>

      <EvidenceCase
        title="Performance Audit · Energy B2C/B2B"
        context="Auditoría de adquisición y performance digital que combinó Google Ads, Search Console, SEO técnico, landings y atribución."
        scope="Ads · Search Console · SEO · CRO"
        metrics={[
          {
            value: '~2M',
            label: 'Impresiones orgánicas analizadas',
            context: 'Search Console · 12 meses',
            // Sin count-up: la tilde dice que el número es aproximado, y
            // animarlo de 0 a 2 le pondría una precisión que no tiene.
            countUp: false,
          },
          {
            value: '46,4K',
            label: 'Impresiones de Google Ads',
            context: 'analizadas en una semana',
          },
          {
            // 23,1% y no 23%: es el mismo dato con un decimal mas, derivado de
            // los montos auditados (45.918 / 198.622 = 0,2312). Los importes ya
            // no se publican, asi que el porcentaje es ahora la unica forma en
            // que ese hallazgo llega al lector.
            value: '23,1%',
            label: 'Del presupuesto analizado',
            context: 'detectado en términos de búsqueda sin conversión',
            status: 'attention',
          },
          {
            value: '15/15',
            label: 'Páginas monitorizadas',
            context: 'con Core Web Vitals móvil en estado malo',
            status: 'attention',
          },
        ]}
        sourceNote="Datos provenientes de una cuenta y una propiedad auditadas. No son resultados producidos por digitAI Motor."
        findingLead="El problema no estaba en una sola campaña."
        findingDetail="Detectamos señales de fuga en adquisición, orgánico, infraestructura y atribución."
        narrative={[
          'Solo cuatro páginas comerciales acumulaban más de 263.000 impresiones, mientras sus CTR orgánicos se movían entre 0,14% y 0,77%. Alta visibilidad, pero muy baja captura de clic.',
        ]}
        secondaryTitle="Señales detectadas"
        secondary={[
          { label: 'Términos con inversión y cero conversiones', value: '129' },
          { label: 'Clics fragmentados entre 4 variantes de la home', value: '9.465' },
          { label: 'Del tráfico era móvil, aprox.', value: '87%' },
          { label: 'Conversiones registradas en la semana analizada', value: '58,97' },
        ]}
        recommended={[
          'Revisión de términos y palabras negativas',
          'Canonicalización de las variantes de la home',
          'Corrección de Core Web Vitals en móvil',
          'Revisión de estructura de campañas y presupuesto',
          'Revisión de landing y conversión',
          'Corrección del modelo de atribución',
        ]}
        closing="Performance también consiste en saber qué dejar de pagar."
        traceability="Caso real · Google Ads · 16–22 jul 2026 · Datos anonimizados."
      />   </div>
  </section>

  <!-- 07 · QUICK FIX -->
  <section class="section" id="quick-fix" aria-labelledby="qf-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow eyebrow--dot">Quick Fix</p>
        <h2 id="qf-title">No todo necesita un proyecto de tres meses.</h2>
        <p class="section-head__lead">
          Si existe un problema puntual, entramos directamente ahí.
        </p>
      </div>

      <QuickFixMatrix items={quickFixItems} />

      <div class="qf-footer">
        <Button
          label="Contame qué está fallando"
          href={ANCHORS.growthAudit}
          arrow
          trackingEvent="quick_fix_click"
          trackingContext="quick_fix_section"
        />
        <p class="source-note">
          También trabajamos sobre problemas puntuales y proyectos acotados.
        </p>
      </div>
    </div>
  </section>

  <!-- 08 · BUSINESS PERSPECTIVE -->
  <section class="section section--alt" aria-labelledby="founder-title">
    <div class="container">
      <FounderNote
        eyebrow="Business perspective"
        title="Performance con criterio comercial."
        paragraphs={[
          '+10 años en ventas B2B, negociación y gestión comercial.',
          'Por eso una campaña no termina cuando genera un lead: queremos saber qué ocurrió después.',
        ]}
        quote="Una campaña no se juzga solamente por CTR o CPL."
        statsTitle="Organic B2B Distribution"
        stats={[
          { label: 'Seguidores', value: '1.749' },
          { label: 'Crecimiento vs. los 365 días previos', value: '+281%' },
          { label: 'Alcance fuera de la red existente', value: '71%' },
        ]}
        statsNote="Datos de perfil personal de LinkedIn."
        ctaLabel="Ver perfil en LinkedIn"
        ctaHref={LINKEDIN_URL}
      />
    </div>
  </section>

  <!-- 09 · FAQ -->
  <section class="section" aria-labelledby="faq-title">
    <div class="container container--narrow">
      <div class="section-head">
        <p class="eyebrow eyebrow--dot">FAQ</p>
        <h2 id="faq-title">Preguntas antes de empezar.</h2>
      </div>

      <FAQ items={faqs} />
    </div>
  </section>

  <!-- 10 · FINAL CTA -->
  <ContactIntent />
</BaseLayout>

<style>
  /* Cierre de seccion: frase que resume, en escala de heading pero sin ser
     un heading. No entra en la jerarquia de encabezados. */
  .closing-line {
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
    max-width: 34ch;
  }

  /* Performance Creative tiene lenguaje visual propio dentro del mismo
     design system: fondo con halo lateral y un kicker en ingles que no
     aparece en ninguna otra seccion. */
  .creative-section {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .creative-section::before {
    content: '';
    position: absolute;
    inset-block-start: -10%;
    inset-inline-start: -12%;
    inline-size: 38rem;
    block-size: 38rem;
    z-index: -1;
    background: radial-gradient(circle, rgba(35, 136, 255, 0.1), transparent 62%);
    pointer-events: none;
  }

  .creative-section__head {
    max-width: 52rem;
  }

  .creative-section__kicker {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    color: var(--accent);
  }

  .creative-section__cta {
    margin-top: var(--space-lg);
  }

  .qf-footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

</style>
