---
import ServiceLayout from '../layouts/ServiceLayout.astro';
import ServiceSection from '../components/ServiceSection.astro';
import CheckList from '../components/CheckList.astro';
import CreativeFlow from '../components/CreativeFlow.astro';
import FAQ from '../components/FAQ.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import ServiceHeroVideo from '../components/ServiceHeroVideo.astro';
import { intentLink } from '../data/navigation';

const research = [
  'Entrevistas y material comercial existente',
  'Objeciones reales del proceso de venta',
  'Reseñas, chats y consultas entrantes',
  'Lenguaje del cliente, no el del brief',
  'Competencia: qué ángulo ya está saturado',
  'Histórico de creativos y qué mostró señal',
];

const testeamos = [
  'Concepto A contra concepto B',
  'Hook A contra hook B',
  'Problema contra beneficio',
  'Founder contra UGC',
  'Demostración contra testimonio',
  'Educación contra respuesta directa',
  'Estático contra reel',
  'Oferta A contra oferta B',
];

const iteracion = [
  'Un mensaje con señal se lleva a nuevos formatos antes de descartarse',
  'Reel a estático, carrusel, UGC, testimonial o pieza gráfica',
  'Nuevos hooks sobre el mismo ángulo ganador',
  'Versiones por temperatura de audiencia',
  'Lo que no muestra señal se archiva con la hipótesis que descartó',
];

const faqs = [
  {
    question: '¿Producen las piezas o solo la estrategia?',
    answer:
      'Ambas cosas, según el caso. Lo que no hacemos es producir sin hipótesis: cada pieza entra a testear algo concreto y se lee contra una métrica definida de antemano.',
  },
  {
    question: '¿Cuántos creativos hacen falta para tener una lectura?',
    answer:
      'Depende del volumen de la cuenta y del presupuesto disponible. Sin tráfico suficiente por variante no hay señal, solo ruido — y en ese caso lo decimos en vez de entregar conclusiones que no se sostienen.',
  },
  {
    question: '¿Trabajan con el material que ya tenemos?',
    answer:
      'Sí, y suele ser el mejor punto de partida. El histórico de creativos muestra qué ángulos ya se probaron y cuáles nunca se exploraron.',
  },
  {
    question: '¿Esto reemplaza a mi diseñador o agencia creativa?',
    answer:
      'No necesariamente. Performance Creative define qué probar y por qué; la producción puede quedar en tu equipo. Lo importante es que la decisión de qué producir salga de datos y no de gusto.',
  },
];
---

<ServiceLayout
  title="Performance Creative y creative testing | digitAI Motor"
  description="Research, ángulos, conceptos, hooks y testing. Convertimos creatividad en hipótesis medibles y leemos qué merece iteración."
  eyebrow="Performance Creative"
  heading="Tu próximo ganador puede estar escondido en lo que todavía no probaste."
  intro="Research, ángulos, hooks y creative testing. Convertimos creatividad en hipótesis que se leen contra una métrica."
  breadcrumbs={[{ label: 'Performance Creative' }]}
  serviceType="Creative strategy"
  cta={{
    title: 'Encontramos dónde se rompe. Después lo arreglamos.',
    micro: "Diagnose. Test. Improve. Scale.",
    primary: { label: 'Solicitar análisis creativo', href: intentLink('performance_creative') },
    secondary: { label: 'Ver Growth Audit', href: '/growth-audit/' },
  }}
>
  <p slot="hero-micro" class="hero-micro">Creative isn't decoration. It's performance.</p>

  <ServiceHeroVideo
    slot="hero-visual"
    videoSrc="/assets/service-heroes/performance-creative.mp4"
    posterSrc="/assets/service-heroes/performance-creative.webp"
    objectPosition="center 48%"
    brightness={0.9}
    saturation={0.88}
    contrast={1.06}
  />

  <ServiceSection
    eyebrow="El sistema"
    title="De research a señal, y de señal a escala."
    lead="Cada concepto entra como hipótesis. El test decide si se aprende o se itera."
    alt
    id="sistema"
  >
    <div class="pc-space">
      <p class="pc-space__label">El espacio de prueba</p>
      <ul class="pc-axes" role="list">
        <li><span class="pc-axis">Concepto</span><span class="pc-mult" aria-hidden="true">×</span></li>
        <li><span class="pc-axis">Hook</span><span class="pc-mult" aria-hidden="true">×</span></li>
        <li><span class="pc-axis">Formato</span><span class="pc-mult" aria-hidden="true">×</span></li>
        <li><span class="pc-axis">Oferta</span></li>
      </ul>
      <p class="pc-space__note">
        Cada eje multiplica lo que queda por probar. Por eso el ganador rara
        vez es la variante que ya se probó.
      </p>
    </div>

    <CreativeFlow />
  </ServiceSection>

  <ServiceSection
    eyebrow="Research"
    title="El ángulo no se inventa en una reunión."
    lead="Sale del lenguaje real del cliente."
    id="research"
  >
    <CheckList items={research} />
  </ServiceSection>

  <ServiceSection
    eyebrow="Testing"
    title="No probamos fondo rojo contra fondo azul."
    lead="Primero testeamos decisiones grandes: concepto, hook, mensaje, formato y oferta."
    alt
    id="testing"
  >
    <CheckList items={testeamos} columns={2} />
  </ServiceSection>

  <ServiceSection
    eyebrow="Iteración"
    title="Un insight ganador no se reinicia desde cero."
    id="iteracion"
  >
    <CheckList items={iteracion} />
  </ServiceSection>

  <ServiceSection title="Preguntas frecuentes." narrow id="faq">
    <FAQ items={faqs} />
    <div class="pc-related">
      <RelatedLinks
        items={[
          {
            label: 'Meta Ads',
            href: '/meta-ads/',
            reason: 'Es donde el creativo tiene más peso: sin demanda que busque, el ángulo hace todo el trabajo.',
          },
          {
            label: 'CRO & Landing Pages',
            href: '/cro-landing-pages/',
            reason: 'Si el ángulo cambia, la landing tiene que responder a esa promesa y no a la anterior.',
          },
        ]}
      />
    </div>
  </ServiceSection>
</ServiceLayout>

<style>
  .pc-space {
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--border);
  }

  .pc-space__label {
    font-family: var(--font-heading);
    font-size: var(--text-2xs);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .pc-axes {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs);
    margin: var(--space-2xs) 0 0;
    padding: 0;
    list-style: none;
  }

  .pc-axes li {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2xs);
  }

  .pc-axis {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
  }

  /* El signo es el argumento: no son cuatro cosas, es su producto. */
  .pc-mult {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    color: var(--accent);
  }

  .pc-space__note {
    margin-top: var(--space-2xs);
    max-width: 48ch;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-secondary);
  }

  .pc-related {
    margin-top: var(--space-xl);
  }

  @media (min-width: 64rem) {
    .pc-hero-aside {
      margin-top: var(--space-xl);
    }
  }
</style>
