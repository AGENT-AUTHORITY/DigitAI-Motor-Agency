---
import ServiceLayout from '../layouts/ServiceLayout.astro';
import ServiceSection from '../components/ServiceSection.astro';
import ServiceHeroVideo from '../components/ServiceHeroVideo.astro';
import CheckList from '../components/CheckList.astro';
import MetricCard from '../components/MetricCard.astro';
import FAQ from '../components/FAQ.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { intentLink } from '../data/navigation';

const alcance = [
  'Estructura de campañas, grupos y presupuesto',
  'Search: intención, concordancias y términos reales',
  'Palabras negativas revisadas de forma periódica',
  'Display: cuándo suma y cuándo solo consume',
  'Remarketing segmentado por etapa, no por defecto',
  'Conversion tracking que represente negocio',
  'Experiencia de la landing y su relación con el anuncio',
  'Calidad de lead, no solo cantidad',
];

const auditoria = [
  'Términos de búsqueda con inversión y sin conversión',
  'Solapamiento entre campañas por el mismo término',
  'Conversiones duplicadas o mal atribuidas',
  'Campañas de Display heredadas que nadie revisa',
  'Presupuesto concentrado donde ya no rinde',
];

const faqs = [
  {
    question: '¿Auditan cuentas que gestiona otra agencia?',
    answer:
      'Sí. La auditoría se entrega igual y es tuya, la ejecute quien la ejecute. No condicionamos el diagnóstico a quedarnos con la gestión.',
  },
  {
    question: '¿Por qué empiezan por los términos de búsqueda?',
    answer:
      'Porque es donde el desvío suele ser más grande y más fácil de demostrar con datos de la propia cuenta. En la auditoría publicada en la home, 129 términos acumulaban inversión sin registrar una sola conversión.',
  },
  {
    question: '¿Trabajan Performance Max?',
    answer:
      'Sí, con la salvedad de que su opacidad exige más rigor en la medición externa. Sin buena señal de conversión, delegar la optimización a la automatización amplifica el error en vez de corregirlo.',
  },
];
---

<ServiceLayout
  title="Gestión y Auditoría de Google Ads | digitAI Motor"
  description="Gestión y auditoría de Google Ads: estructura, términos de búsqueda, negativas, tracking y calidad de lead. Optimizado para negocio, no para métricas bonitas."
  eyebrow="Google Ads"
  heading="No todo clic merece tu presupuesto."
  intro="Filtramos intención, estructura y términos para encontrar dónde se está pagando por tráfico que no acerca una conversión."
  breadcrumbs={[{ label: 'Paid Media', href: '/paid-media/' }, { label: 'Google Ads' }]}
  serviceType="Google Ads management"
  cta={{
    title: 'Encontramos dónde se rompe. Después lo arreglamos.',
    micro: "Diagnose. Test. Improve. Scale.",
    primary: { label: 'Auditar Google Ads', href: intentLink('google_ads') },
    secondary: { label: 'Ver Growth Audit', href: '/growth-audit/' },
  }}
>
  <p slot="hero-micro" class="hero-micro">Turn search intent into conversion signal.</p>

  <ServiceHeroVideo
    slot="hero-visual"
    videoSrc="/assets/service-heroes/google-ads.mp4"
    posterSrc="/assets/service-heroes/google-ads.webp"
    objectPosition="center 52%"
    brightness={0.94}
    saturation={0.9}
    contrast={1.06}
  />

  <ServiceSection eyebrow="Alcance" title="Sobre qué trabajamos." alt id="alcance">
    <CheckList items={alcance} />
  </ServiceSection>

  <ServiceSection
    eyebrow="Evidencia"
    title="Lo que suele aparecer en una auditoría."
    lead="Estos números vienen de una cuenta auditada en el sector energético, no de resultados producidos por digitAI Motor. El caso completo está en la home."
    id="evidencia"
  >
    <div class="ga-metrics">
      <MetricCard
        value="129"
        label="Términos con inversión"
        context="y sin conversiones registradas"
        status="attention"
      />
      {/* Eran dos tarjetas: el importe absoluto (ARS 45.918) y su proporcion
          (23%). El importe sale de la presentacion publica, y como la
          proporcion ya estaba, conservar ambas habria dejado 23% y 23,1% en
          pantalla al mismo tiempo: dos cifras distintas para el mismo dato.
          Queda una sola, con la precision real (45.918 / 198.622 = 0,2312). */}
      <MetricCard
        value="23,1%"
        label="Del presupuesto analizado"
        context="detectado en términos de búsqueda sin conversión"
        status="attention"
      />
    </div>
    <p class="source-note ga-note">
      Período 16 al 22 de julio de 2026. Datos provenientes de una cuenta
      auditada. No son resultados producidos por digitAI Motor.
    </p>
  </ServiceSection>

  <ServiceSection
    eyebrow="Después del clic"
    title="La intención puede ser buena y aun así perderse."
    id="despues-del-clic"
  >
    <p class="ga-bridge">
      Un término de búsqueda correcto, con la puja correcta, puede terminar en
      una página que responde otra cosa. Cuando eso pasa, el problema deja de
      estar en la cuenta: está en
      <a href="/cro-landing-pages/">lo que ocurre después del clic</a>.
    </p>
  </ServiceSection>

  <ServiceSection eyebrow="Auditoría" title="Qué buscamos primero." alt id="auditoria">
    <CheckList items={auditoria} />
  </ServiceSection>

  <ServiceSection title="Preguntas frecuentes." narrow id="faq">
    <FAQ items={faqs} />
    <div class="ga-related">
      <RelatedLinks
        items={[
          {
            label: 'CRO & Landing Pages',
            href: '/cro-landing-pages/',
            reason: 'Si el término es correcto pero la página no responde a esa búsqueda, la intención se pierde después del clic.',
          },
          {
            label: 'Growth Audit',
            href: '/growth-audit/',
            reason: 'Si no está claro dónde se está yendo el presupuesto, conviene mirar el recorrido completo antes de optimizar.',
          },
        ]}
      />
    </div>
  </ServiceSection>
</ServiceLayout>

<style>
  .ga-related {
    margin-top: var(--space-xl);
  }

  .ga-metrics {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xs);
  }

  .ga-note {
    margin-top: var(--space-md);
  }

  @media (min-width: 48rem) {
    /* Dos columnas y no tres: quedaron dos tarjetas al retirar el importe
       absoluto. Con repeat(3) la tercera columna quedaba vacia. */
    .ga-metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-md);
    }
  }
</style>

<style>
  .ga-bridge {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    max-width: 56ch;
  }
</style>
