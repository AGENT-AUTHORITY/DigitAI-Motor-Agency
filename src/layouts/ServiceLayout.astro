---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTASection from '../components/CTASection.astro';
import Button from '../components/Button.astro';
import type { Crumb } from '../components/Breadcrumbs.astro';

/**
 * ServiceLayout — envoltorio de las paginas de servicio.
 *
 * Aporta breadcrumbs, encabezado de servicio, schema `Service` y el CTA de
 * cierre, para que cada service page solo escriba su contenido propio.
 */
export interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  intro: string;
  breadcrumbs: Crumb[];
  /** Nombre del servicio para JSON-LD. Por defecto, el heading. */
  serviceName?: string;
  serviceType?: string;
  canonicalPath?: string;
  ogImage?: string;
  /** Solo para forzar. Por defecto lo decide el interruptor de publicacion. */
  noindex?: boolean;
  cta?: {
    title: string;
    description?: string;
    /** Microcopy en ingles del cierre. */
    micro?: string;
    primary: { label: string; href: string };
    secondary?: { label: string; href: string };
  };
}

const {
  title,
  description,
  eyebrow,
  heading,
  intro,
  breadcrumbs,
  serviceName,
  serviceType,
  canonicalPath,
  ogImage,
  noindex,
  cta,
} = Astro.props;

// Astro.slots.has() se resuelve en build: sin slot, no se emite ni la clase
// ni el contenedor del visual.
const tieneVisual = Astro.slots.has('hero-visual');

const site = Astro.site ?? new URL('https://www.digitaimotor.lat');
const canonical = new URL(canonicalPath ?? Astro.url.pathname, site).href;

// Sin AggregateRating ni Review: no hay reviews verificables (docs/SEO.md).
// La V1 los tenia inventados en el JSON-LD de la home.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: serviceName ?? heading,
  description,
  url: canonical,
  ...(serviceType ? { serviceType } : {}),
  provider: {
    '@type': 'Organization',
    name: 'digitAI Motor',
    url: site.href,
  },
  areaServed: [
    { '@type': 'Country', name: 'Argentina' },
    { '@type': 'Place', name: 'LATAM' },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  ogImage={ogImage}
  noindex={noindex}
  schema={[serviceSchema]}
>
  <div class="service-page">
    <div
      class:list={['container', 'service-page__head', { 'service-page__head--visual': tieneVisual }]}
    >
      <Breadcrumbs items={breadcrumbs} />

      {
        tieneVisual ? (
          <>
            <div class="service-page__hero-copy">
              <p class="eyebrow eyebrow--dot service-page__eyebrow">{eyebrow}</p>
              <h1 class="service-page__title">{heading}</h1>
              {/* `intro` se renderizaba SOLO en la rama sin visual, asi que una
                  pagina con hero-visual pasaba la prop y perdia la frase que
                  explica el servicio. Era una regresion silenciosa frente a las
                  otras siete service pages, y le habria pasado a cualquier
                  pagina futura con visual. */}
              <p class="service-page__intro service-page__intro--visual">{intro}</p>
              <slot name="hero-micro" />
              {cta && (
                <div class="service-page__hero-cta">
                  <Button label={cta.primary.label} href={cta.primary.href} arrow />
                </div>
              )}
              <slot name="hero-aside" />
            </div>
            <div class="service-page__hero-visual">
              <slot name="hero-visual" />
            </div>
          </>
        ) : (
          <>
            <p class="eyebrow eyebrow--dot service-page__eyebrow">{eyebrow}</p>
            <h1 class="service-page__title">{heading}</h1>
            <p class="service-page__intro">{intro}</p>
          </>
        )
      }
    </div>

    <slot />

    {
      cta && (
        <CTASection
          title={cta.title}
          description={cta.description}
          micro={cta.micro}
          primaryCta={cta.primary}
          secondaryCta={cta.secondary}
          visual
        />
      )
    }
  </div>
</BaseLayout>

<style>
  /* El hero con visual deja que la imagen se desborde a proposito en mobile
     para sentirse grande. El desborde se recorta aca, que es el unico ancestro
     con el ancho completo de la pagina.
     clip y no hidden: hidden crearia un contenedor de scroll y romperia
     cualquier position:sticky descendiente. Donde nada se desborda, esto no
     hace nada. */
  .service-page {
    overflow-x: clip;
  }

  .service-page__hero-cta {
    margin-top: var(--space-lg);
  }

  /* Microcopy en ingles: firma conceptual, no traduccion. Secundario por
     tamano y color, nunca compitiendo con el H1. */
  .service-page__head--visual :global(.hero-micro) {
    margin-top: var(--space-md);
    font-family: var(--font-heading);
    font-size: var(--text-2xs);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .service-page__head--visual .service-page__intro--visual {
    max-width: 42ch;
  }

  .service-page__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-block: var(--space-xl) var(--space-section);
  }

  .service-page__eyebrow {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
  }

  .service-page__title {
    font-size: var(--text-4xl);
    max-width: 20ch;
    margin-bottom: var(--space-md);
  }

  .service-page__intro {
    max-width: 54ch;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  /* Variante editorial: copy a la izquierda, visual a la derecha. Se activa
     solo cuando la pagina pasa el slot hero-visual. Sin altura fija: el hero
     respira pero no ocupa la pantalla entera. */
  .service-page__head--visual {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: center;
    padding-block: var(--space-lg) var(--space-section);
  }

  .service-page__head--visual .service-page__eyebrow {
    margin-top: var(--space-md);
  }

  .service-page__head--visual .service-page__title {
    /* Mas chico que la variante textual: a 60px el titular ocupaba cinco
       lineas y no dejaba aire para el visual. */
    font-size: clamp(2.25rem, 1.5rem + 2.2vw, 3.125rem);
    max-width: 15ch;
    margin-bottom: 0;
  }

  .service-page__hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* En mobile el visual va al final, despues del CTA. */
    order: 1;
  }

  /* Mas corta que en la variante textual: comparte ancho con el visual. */
  .service-page__intro--visual {
    margin-top: var(--space-sm);
    max-width: 42ch;
    font-size: var(--text-base);
  }

  .service-page__hero-visual {
    order: 2;
    min-width: 0;
  }

  /* El breadcrumb ocupa el ancho completo, no una de las dos columnas. */
  .service-page__head--visual > :global(nav) {
    grid-column: 1 / -1;
  }

  @media (min-width: 64rem) {
    .service-page__head--visual {
      /* 40 / 60: el copy orienta, la visual explica el mecanismo. */
      grid-template-columns: minmax(0, 0.68fr) minmax(0, 1fr);
      column-gap: var(--space-xl);
      padding-block: var(--space-xl) var(--space-section);
    }

    .service-page__head--visual .service-page__title {
      /* 16ch dejaba el titular de Paid Media en cinco lineas. Con 20ch los
         cinco H1 caen en dos o tres, que es el maximo que se lee de un vistazo. */
      max-width: 20ch;
    }
  }

</style>
