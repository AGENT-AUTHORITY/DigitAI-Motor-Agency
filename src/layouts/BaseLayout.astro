---
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/components.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { SITE_IS_PUBLIC } from '../../site.config.mjs';

export interface Props {
  title: string;
  description: string;
  /** Ruta canonica con trailing slash. Por defecto, la ruta actual. */
  canonicalPath?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /**
   * Fuerza noindex en una pagina puntual (404). Sin esto, el estado sale del
   * interruptor de publicacion: cuando el sitio pasa a publico, el noindex
   * desaparece solo. Antes se escribia a mano pagina por pagina y publicar
   * habria dejado 11 paginas con noindex y un sitemap listandolas.
   */
  /** Objetos JSON-LD ya construidos. Se serializan tal cual. */
  schema?: Record<string, unknown>[];
  bodyClass?: string;
}

const {
  title,
  description,
  canonicalPath,
  ogImage,
  ogType = 'website',
  noindex = !SITE_IS_PUBLIC,
  schema = [],
  bodyClass,
} = Astro.props;

// Canonico derivado de `site` en astro.config.mjs. Nunca hardcodeado:
// la V1 declaraba no-www en las 6 paginas mientras produccion redirige a www.
const site = Astro.site ?? new URL('https://www.digitaimotor.lat');
const path = canonicalPath ?? Astro.url.pathname;
const canonical = new URL(path, site).href;
// Social card oficial, 1200x630 PNG. PNG y no WebP: LinkedIn y WhatsApp no
// resuelven WebP de forma confiable en preview.
// La V1 declaraba /assets/og-image.png sin que el archivo existiera y cada
// share salia sin imagen. Ahora existe, y ademas se verifica en QA.
const OG_DEFAULT = '/assets/og-default.png';
const ogImageUrl = new URL(ogImage ?? OG_DEFAULT, site).href;

---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="digitAI Motor — Growth Partner. Performance, Creative, Conversion y Growth Systems." />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="digitAI motor" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="theme-color" content="#05070B" />

    <!-- Solo el peso critico del H1. Preload de mas compite con el LCP. -->
    <link
      rel="preload"
      href="/fonts/manrope-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {schema.map((entry) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}

    <!-- Marca html.js antes del primer paint: sin esto los elementos con
         [data-reveal] parpadearian visibles antes de ocultarse (FOUC). -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <Analytics />
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Reveal en scroll sin libreria. GSAP + ScrollTrigger de la V1 eran
      // ~70 KB de CDN para esto mismo, y dejaron contenido invisible dos
      // veces (commits 8e7c262 y 1306f34).
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      const targets = document.querySelectorAll('[data-reveal]');

      if (reduced.matches || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.setAttribute('data-reveal', 'in'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.setAttribute('data-reveal', 'in');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );
        targets.forEach((el) => observer.observe(el));

        // Red de seguridad: nada puede quedar invisible de forma permanente.
        // Si por cualquier motivo el observer no disparo (scroll programatico
        // que saltea posiciones, captura full-page, viewport raro), a los 3s
        // se revela todo lo que siga oculto. La V1 envio a produccion
        // contenido invisible dos veces por no tener esto.
        window.setTimeout(() => {
          targets.forEach((el) => el.setAttribute('data-reveal', 'in'));
        }, 3000);
      }
    </script>
  </body>
</html>
