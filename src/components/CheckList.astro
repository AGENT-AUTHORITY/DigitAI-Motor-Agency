---
/**
 * CheckList — lista de alcance.
 *
 * Se usa en las paginas de servicio para enumerar que entra en el trabajo.
 * Dos columnas en desktop, una en mobile. Sin iconos genericos: una barra de
 * acento corta por item.
 */
export interface Props {
  items: string[];
  columns?: 2 | 3;
}

const { items, columns = 2 } = Astro.props;
---

<ul class:list={['cl', `cl--${columns}`]} role="list">
  {
    items.map((item, i) => (
      <li class="cl__item" data-reveal data-reveal-delay={String((i % 3) + 1)}>
        <span class="cl__mark" aria-hidden="true" />
        {item}
      </li>
    ))
  }
</ul>

<style>
  .cl {
    display: grid;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .cl__item {
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    align-items: baseline;
    gap: var(--space-2xs);
    padding-block: var(--space-sm);
    border-bottom: 1px solid var(--border);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--text-secondary);
  }

  .cl__mark {
    inline-size: 0.75rem;
    block-size: 2px;
    background: var(--accent);
    align-self: center;
  }

  @media (min-width: 48rem) {
    .cl--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-xl); }
    .cl--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--space-lg); }
  }
</style>
