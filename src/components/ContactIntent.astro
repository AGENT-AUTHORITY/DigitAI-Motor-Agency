---
import { WHATSAPP_NUMBER, SITE, SERVICE_INTENTS, INTENT_UNSURE } from '../data/navigation';
import { EVENTS, TRACK_FN } from '../lib/analytics';

// La direccion del mensaje de error tiene que salir de la misma fuente que el
// resto: escrita a mano quedaria vieja al cambiar de canal corporativo.
const CONTACT_MAIL = SITE.email;

// Se pasan como constantes planas y no como objeto: define:vars inyecta
// valores, y un identificador de objeto deja al type-checker sin forma de
// resolver los accesos dentro del inline script.
const EV_INTENT = EVENTS.SERVICE_INTENT_SELECTED;
const EV_FORM = EVENTS.CONTACT_FORM_COMPLETED;
const EV_HANDOFF = EVENTS.WHATSAPP_HANDOFF_STARTED;
const EV_LEAD = EVENTS.LEAD_DELIVERED;
const EV_LEAD_FAIL = EVENTS.LEAD_DELIVERY_FAILED;

/**
 * Endpoint de entrega. Vacio = el formulario sigue funcionando exactamente
 * como antes (solo handoff a WhatsApp) y no sale ningun request: mismo
 * fail-safe que usa Analytics.astro con el ID de GA4.
 *
 * Con endpoint configurado, la entrega deja de depender de que la persona
 * apriete enviar en WhatsApp. Los datos llegan igual.
 */
const FORM_ENDPOINT = import.meta.env.PUBLIC_FORM_ENDPOINT?.trim() || '';

/**
 * ContactIntent — bloque de conversion final.
 *
 * ENTREGA: depende de `PUBLIC_FORM_ENDPOINT`.
 *
 *   Con endpoint  -> los datos se envian por POST y quedan registrados aunque
 *                    la persona nunca mande el mensaje de WhatsApp. WhatsApp
 *                    pasa a ser la continuacion de la conversacion.
 *   Sin endpoint  -> comportamiento anterior: unicamente handoff a WhatsApp.
 *
 * REGLA QUE NO CAMBIA: el estado dice literalmente lo que paso. Nunca se
 * muestra "recibimos tus datos" si el POST no confirmo, ni "enviado" si no se
 * envio a ningun lado.
 *
 * El POST se dispara ANTES de `window.open` pero no se espera: abrir la
 * ventana tiene que ocurrir dentro del mismo gesto del usuario o el navegador
 * la bloquea.
 */
const OPTIONS = [
  ...Object.entries(SERVICE_INTENTS).map(([value, label]) => ({ value, label })),
  { value: INTENT_UNSURE.key, label: INTENT_UNSURE.label },
];
---

<section class="contact section--lg" id="growth-audit" aria-labelledby="contact-title">
  <div class="container contact__inner">
    <div class="contact__pitch">
      <p class="eyebrow eyebrow--dot">Growth Audit</p>
      <h2 id="contact-title" class="contact__title">
        <span>Antes de gastar más,</span>
        <span>encontremos qué está frenando el crecimiento.</span>
      </h2>
      <p class="contact__body">
        Contanos qué estás intentando mejorar. Si el cuello de botella está en
        adquisición, creatividad, conversión, medición o proceso comercial,
        empezamos por ahí.
      </p>
      <p class="contact__promise">
        Primero diagnosticamos. Después cotizamos.
      </p>

      {/* Responde la pregunta que bloquea el envio y que el bloque no
          contestaba en ninguna parte: que pasa despues de apretar el boton.
          Sin plazo de respuesta: no se promete un tiempo que no este
          comprometido. */}
      <div class="contact__next">
        <p class="contact__next-label">Qué pasa después</p>
        <ol class="contact__steps">
          <li>Nos contás qué está fallando. La conversación sigue por WhatsApp.</li>
          <li>Lo lee y responde Oscar Chinchilla.</li>
          <li>Si tiene sentido avanzar, coordinamos el diagnóstico.</li>
        </ol>
        <p class="contact__readonly">
          El diagnóstico es lectura sobre cuentas, analytics y CRM.
          <strong>Sin tocar nada.</strong>
        </p>
      </div>
    </div>

    <form class="contact__form surface surface--lg" id="growth-audit-form" novalidate>
      <div class="field">
        <label class="field__label" for="cf-name">Nombre</label>
        <input class="field__input" id="cf-name" name="name" type="text" autocomplete="name" required />
        <p class="field__error" id="cf-name-error" aria-live="polite"></p>
      </div>

      <div class="field">
        <label class="field__label" for="cf-company">
          Empresa <span class="field__optional">(opcional)</span>
        </label>
        <input class="field__input" id="cf-company" name="company" type="text" autocomplete="organization" />
      </div>

      <div class="field">
        <label class="field__label" for="cf-contact">Email o WhatsApp</label>
        <input class="field__input" id="cf-contact" name="contact" type="text" inputmode="email" autocomplete="email" required />
        <p class="field__error" id="cf-contact-error" aria-live="polite"></p>
      </div>

      <div class="field">
        <label class="field__label" for="cf-site">
          Web <span class="field__optional">(opcional)</span>
        </label>
        <input class="field__input" id="cf-site" name="website" type="text" inputmode="url" placeholder="tuempresa.com" />
      </div>

      <div class="field field--full">
        <label class="field__label" for="cf-interest">¿Sobre qué querés que miremos?</label>
        <select class="field__input" id="cf-interest" name="interest" required>
          <option value="">Elegí una opción</option>
          {OPTIONS.map((o) => <option value={o.value}>{o.label}</option>)}
        </select>
        <p class="field__error" id="cf-interest-error" aria-live="polite"></p>
      </div>

      <div class="field field--full">
        <label class="field__label" for="cf-detail">Contexto <span class="field__optional">(opcional)</span></label>
        <textarea class="field__input field__input--area" id="cf-detail" name="detail" rows="3"></textarea>
      </div>

      <input type="hidden" name="utm_source" />
      <input type="hidden" name="utm_medium" />
      <input type="hidden" name="utm_campaign" />
      <input type="hidden" name="utm_content" />
      <input type="hidden" name="utm_term" />
      <input type="hidden" name="referrer" />
      <input type="hidden" name="landing_page" />

      <div class="contact__actions">
        {/* El submit abre WhatsApp. Anunciarlo ANTES del click y no despues:
            un salto a otra aplicacion sin aviso se lee como redireccion no
            pedida, justo en el momento de mayor desconfianza. */}
        <p class="contact__handoff" id="cf-handoff">
          Al enviar se abre WhatsApp con tus datos ya cargados. El mensaje lo
          mandás vos.
        </p>
        <button
          class="btn btn--primary btn--lg btn--block"
          type="submit"
          aria-describedby="cf-handoff"
          data-track="form_submit"
          data-track-context="growth_audit"
        >
          Solicitar diagnóstico de crecimiento
        </button>
        <p class="contact__status" role="status" aria-live="polite" data-form-status></p>
        <p class="source-note contact__fallback">
          También podés escribir a
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
        </p>
      </div>
    </form>
  </div>
</section>

<style>
  .contact {
    background: var(--bg-secondary);
    border-top: 1px solid var(--border);
  }

  .contact__inner {
    display: grid;
    /* minmax(0, 1fr) y no 1fr: por defecto un grid item tiene min-width auto
       y no baja de su min-content. El formulario forzaba la columna a 362px
       dentro de un contenedor de 334px y desbordaba la pagina a 375. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .contact__title {
    margin-top: var(--space-md);
    font-size: var(--text-3xl);
    max-width: 20ch;
  }

  .contact__title span {
    display: block;
  }

  .contact__title span + span {
    color: var(--text-secondary);
  }

  .contact__body {
    margin-top: var(--space-md);
    max-width: 46ch;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  /* Inversion de peso deliberada. Esta frase es el argumento comercial que
     separa a digitAI Motor de una agencia que cotiza antes de mirar, y estaba
     tipografiada como nota al pie: 14px en --text-muted. Ahora es el elemento
     fuerte de la columna, por debajo del H2 y por encima de todo lo demas. */
  .contact__promise {
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
    max-width: 22ch;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
  }

  .contact__next {
    margin-top: var(--space-md);
  }

  .contact__next-label {
    font-family: var(--font-heading);
    font-size: var(--text-2xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* Los numeros los pone el contador y no un ::marker nativo: asi el digito
     toma la tipografia de titulos y el color de acento sin depender de como
     cada navegador estilice la lista. */
  .contact__steps {
    counter-reset: step;
    display: grid;
    gap: var(--space-2xs);
    margin: var(--space-2xs) 0 0;
    padding: 0;
    list-style: none;
  }

  .contact__steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    gap: var(--space-2xs);
    max-width: 44ch;
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--text-secondary);
  }

  .contact__steps li::before {
    content: counter(step);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    font-variant-numeric: tabular-nums;
    line-height: 1.6;
    color: var(--accent);
  }

  .contact__readonly {
    margin-top: var(--space-sm);
    padding: var(--space-2xs) var(--space-xs);
    max-width: 44ch;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-secondary);
    background: var(--accent-soft);
    border-radius: var(--radius-sm);
  }

  .contact__readonly strong {
    color: var(--text-primary);
    font-weight: var(--weight-bold);
  }

  .contact__form {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-sm);
    padding: var(--space-lg) var(--space-md);
  }

  .field {
    display: grid;
    gap: var(--space-3xs);
    /* Los controles traen ancho intrinseco propio (size/cols por defecto).
       Sin min-width 0 empujan la grilla del formulario. */
    min-width: 0;
  }

  .field--full {
    grid-column: 1 / -1;
  }

  .field__label {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    color: var(--text-secondary);
  }

  .field__optional {
    font-weight: var(--weight-normal);
    color: var(--text-muted);
  }

  /* --border-input existe justamente para esto: --border (1.33:1) y
     --border-active (1.90:1) no llegan al 3:1 que WCAG 1.4.11 pide para el
     limite de un control. */
  .field__input {
    inline-size: 100%;
    min-inline-size: 0;
    min-block-size: 2.75rem;
    padding: 0.625rem 0.75rem;
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--text-primary);
    background: var(--bg-primary);
    border: 1px solid var(--border-input);
    border-radius: var(--radius-sm);
    transition: border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .field__input--area {
    min-block-size: 5rem;
    resize: vertical;
  }

  .field__input:hover {
    border-color: var(--text-muted);
  }

  .field__input:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .field__input[aria-invalid='true'] {
    border-color: var(--danger);
  }

  .field__error:empty {
    display: none;
  }

  .field__error {
    font-size: var(--text-xs);
    color: var(--danger);
  }

  .contact__actions {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--space-2xs);
    margin-top: var(--space-2xs);
  }

  /* --text-secondary y no --text-muted: es una advertencia sobre lo que va a
     pasar al hacer click, no una nota al margen. */
  .contact__handoff {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-secondary);
  }

  .contact__status:empty {
    display: none;
  }

  /* Salida real cuando el navegador bloquea el popup. Antes el mensaje era
     texto plano con una direccion no clickeable: la persona quedaba con los
     datos escritos y sin ninguna via de envio. */
  .contact__recovery {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-top: var(--space-2xs);
  }

  .contact__recovery .btn {
    flex: 1 1 auto;
  }

  .contact__status {
    padding: var(--space-2xs) var(--space-xs);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-primary);
    background: var(--accent-soft);
    border: 1px solid var(--accent-line);
    border-radius: var(--radius-sm);
  }

  /* Un fallo de entrega no puede leerse igual que una confirmacion: el estado
     cambia de superficie, no solo de texto. Va DESPUES de .contact__status:
     misma especificidad, asi que el orden es lo unico que decide cual gana. */
  .contact__status--error {
    background: rgba(239, 100, 97, 0.12);
    border-color: rgba(239, 100, 97, 0.34);
  }

  @media (min-width: 34rem) {
    .contact__form {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-sm);
    }
  }

  @media (min-width: 64rem) {
    .contact__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      column-gap: var(--space-2xl);
    }

    .contact__form {
      padding: var(--space-xl);
    }
  }
</style>

<script is:inline define:vars={{ WHATSAPP_NUMBER, TRACK_FN, EV_INTENT, EV_FORM, EV_HANDOFF, EV_LEAD, EV_LEAD_FAIL, CONTACT_MAIL, FORM_ENDPOINT }}>
  const form = document.querySelector('#growth-audit-form');
  if (form) {
    const status = form.querySelector('[data-form-status]');

    // Declarada antes que cualquier llamador. Con tracking deshabilitado
    // dmTrack existe igual y es un no-op, asi que esto nunca condiciona.
    const track = (event, payload) => {
      if (typeof window[TRACK_FN] === 'function') window[TRACK_FN](event, payload);
    };

    const UTM_KEYS = [
      'utm_source',
      'utm_medium',
      'utm_campaign',
      'utm_content',
      'utm_term',
    ];

    // Captura de UTM en el primer landing y persistencia por sesion: si el
    // usuario navega y vuelve, el origen no se pierde.
    const params = new URLSearchParams(window.location.search);
    UTM_KEYS.forEach((key) => {
      const fromUrl = params.get(key);
      if (fromUrl) sessionStorage.setItem(key, fromUrl);
      const field = form.querySelector(`input[name="${key}"]`);
      if (field) field.value = sessionStorage.getItem(key) || '';
    });
    const referrer = form.querySelector('input[name="referrer"]');
    if (referrer) referrer.value = document.referrer || '';
    const landing = form.querySelector('input[name="landing_page"]');
    if (landing) landing.value = window.location.pathname;

    // Intent routing: cada service page abre este formulario con ?intent=<clave>.
    // Solo se acepta si coincide con una opcion real del select, asi un valor
    // arbitrario en la URL no puede inyectar nada ni dejar el campo en un
    // estado invisible. No toca los UTM: son ejes distintos (que quiere la
    // persona vs. de donde vino).
    const interestField = form.querySelector('#cf-interest');
    const requestedIntent = params.get('intent');
    if (interestField && requestedIntent) {
      const match = Array.from(interestField.options).some(
        (opt) => opt.value === requestedIntent
      );
      if (match) {
        interestField.value = requestedIntent;
        track(EV_INTENT, {
          intent: requestedIntent,
          source: 'service_page',
        });
      }
    }

    if (interestField) {
      interestField.addEventListener('change', () => {
        if (!interestField.value) return;
        track(EV_INTENT, {
          intent: interestField.value,
          source: 'form',
        });
      });
    }

    const setError = (input, message) => {
      const target = document.querySelector(`#${input.id}-error`);
      input.setAttribute('aria-invalid', message ? 'true' : 'false');
      if (target) target.textContent = message;
      if (message) input.setAttribute('aria-describedby', `${input.id}-error`);
    };

    // El payload viaja con el label humano: nadie deberia leer
    // "growth_engineering" en un WhatsApp.
    const interestLabel = () => {
      const el = form.querySelector('#cf-interest');
      return el.options[el.selectedIndex]?.text ?? '';
    };

    const validate = () => {
      let firstInvalid = null;

      const name = form.querySelector('#cf-name');
      if (!name.value.trim()) {
        setError(name, 'Necesitamos un nombre para responderte.');
        firstInvalid = firstInvalid || name;
      } else setError(name, '');

      const contact = form.querySelector('#cf-contact');
      const value = contact.value.trim();
      const looksEmail = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value);
      // Contar DIGITOS, no caracteres: el patron anterior media largo total,
      // asi que "1234567" pasaba y entraba un lead irrecuperable. 8 a 15 es el
      // rango de E.164 descontando el minimo nacional mas corto.
      const digits = value.replace(/\D/g, '');
      const looksPhone =
        /^[+()\d\s-]+$/.test(value) && digits.length >= 8 && digits.length <= 15;
      if (!value) {
        setError(contact, 'Dejanos un email o un WhatsApp.');
        firstInvalid = firstInvalid || contact;
      } else if (!looksEmail && !looksPhone) {
        setError(contact, 'Revisá el email o el número: no parece válido.');
        firstInvalid = firstInvalid || contact;
      } else setError(contact, '');

      const interest = form.querySelector('#cf-interest');
      if (!interest.value) {
        setError(interest, 'Elegí sobre qué querés que miremos.');
        firstInvalid = firstInvalid || interest;
      } else setError(interest, '');

      return firstInvalid;
    };

    const submitBtn = form.querySelector('button[type="submit"]');
    const labelOriginal = submitBtn ? submitBtn.textContent : '';
    let enviando = false;

    const setEnviando = (activo) => {
      enviando = activo;
      if (!submitBtn) return;
      submitBtn.disabled = activo;
      submitBtn.textContent = activo ? 'Enviando…' : labelOriginal;
      form.setAttribute('aria-busy', activo ? 'true' : 'false');
    };

    /**
     * POST al endpoint. Devuelve true/false; nunca lanza, porque el llamador
     * necesita distinguir "fallo" de "no habia endpoint" y no puede quedarse
     * sin renderizar estado por una excepcion de red.
     *
     * Se manda todo lo que el formulario ya tiene —incluidos los hidden de UTM
     * y cualquier campo que agregue el servicio elegido, como el access_key de
     * Web3Forms— mas el mensaje ya armado y legible.
     */
    const entregar = async (data, message) => {
      try {
        const payload = Object.fromEntries(data.entries());
        payload.message = message;
        const res = await fetch(FORM_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        return res.ok;
      } catch (e) {
        return false;
      }
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (enviando) return;

      const invalid = validate();
      if (invalid) {
        invalid.focus();
        status.replaceChildren();
        return;
      }

      const data = new FormData(form);

      track(EV_FORM, {
        intent: data.get('interest'),
        has_company: Boolean(data.get('company')),
        has_detail: Boolean(data.get('detail')),
      });

      // FORM DELIVERY PENDING: sin backend. En vez de simular un envio, se
      // entrega por un canal real y el mensaje de estado dice exactamente
      // lo que ocurrio. Nunca "enviado" si no se envio a ningun lado.
      const utm = UTM_KEYS.map((k) => data.get(k))
        .filter(Boolean)
        .join(' / ');

      const message = [
        'Solicitud de diagnóstico de crecimiento',
        '',
        `Nombre: ${data.get('name')}`,
        data.get('company') ? `Empresa: ${data.get('company')}` : '',
        `Contacto: ${data.get('contact')}`,
        data.get('website') ? `Web: ${data.get('website')}` : '',
        `Servicio: ${interestLabel()}`,
        data.get('detail') ? `Contexto: ${data.get('detail')}` : '',
        utm ? `Origen: ${utm}` : '',
      ]
        .filter(Boolean)
        .join('\n');

      const url = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;

      setEnviando(true);

      // La entrega arranca ANTES de abrir la ventana, pero no se espera todavia:
      // window.open tiene que ejecutarse dentro del mismo gesto del usuario o el
      // navegador lo bloquea. fetch() no cede el hilo, asi que las dos lineas
      // siguen siendo el mismo turno sincronico.
      const entrega = FORM_ENDPOINT ? entregar(data, message) : null;
      const opened = window.open(url, '_blank', 'noopener,noreferrer');

      // Significa "el sitio preparo la conversacion", nunca "lead confirmado":
      // nada nos permite saber si la persona apreto enviar en WhatsApp.
      track(EV_HANDOFF, {
        intent: data.get('interest'),
        opened: Boolean(opened),
      });

      // null = no habia endpoint configurado. Es distinto de false, que es un
      // intento de entrega que fallo, y se comunica distinto.
      const entregado = entrega ? await entrega : null;

      // CONVERSION. Se dispara aca y en ningun otro lado: es el unico punto del
      // codigo donde consta que el endpoint respondio 2xx. Ni el submit ni el
      // handoff de WhatsApp prueban que el mensaje haya llegado.
      if (entregado === true) {
        track(EV_LEAD, {
          intent: data.get('interest'),
          // Los UTM viajan con la conversion para que el lead quede atribuido
          // aunque la persona haya navegado entre la landing y el envio.
          utm_source: data.get('utm_source') || '',
          utm_medium: data.get('utm_medium') || '',
          utm_campaign: data.get('utm_campaign') || '',
          utm_content: data.get('utm_content') || '',
          utm_term: data.get('utm_term') || '',
          landing_page: data.get('landing_page') || '',
        });
      } else if (entregado === false) {
        // No es una conversion: es una alarma. Si la entrega se rompe, tiene
        // que verse en GA4 y no descubrirse por leads que nunca llegaron.
        track(EV_LEAD_FAIL, { intent: data.get('interest') });
      }

      setEnviando(false);

      // --- Acciones de recuperacion ---------------------------------------
      // Se arman a demanda segun lo que haga falta ofrecer. Con los datos ya
      // registrados no tiene sentido empujar un mailto: la entrega ocurrio.
      const accionWhatsApp = () => {
        const a = document.createElement('a');
        a.className = 'btn btn--primary btn--sm';
        a.href = url;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
        a.textContent = 'Abrir WhatsApp';
        return a;
      };

      const accionEmail = () => {
        const a = document.createElement('a');
        a.className = 'btn btn--secondary btn--sm';
        a.href = `mailto:${CONTACT_MAIL}?subject=${encodeURIComponent(
          'Solicitud de diagnóstico de crecimiento'
        )}&body=${encodeURIComponent(message)}`;
        a.textContent = 'Enviar por email';
        return a;
      };

      const accionCopiar = () => {
        const b = document.createElement('button');
        b.className = 'btn btn--ghost btn--sm';
        b.type = 'button';
        b.textContent = 'Copiar mensaje';
        b.addEventListener('click', () => {
          // navigator.clipboard no existe fuera de contexto seguro. Sin esta
          // guarda, `?.writeText()` devuelve undefined y el .then() rompe.
          const copied = navigator.clipboard && navigator.clipboard.writeText(message);
          if (!copied) {
            b.textContent = 'No se pudo copiar';
            return;
          }
          copied.then(
            () => {
              b.textContent = 'Copiado';
            },
            () => {
              b.textContent = 'No se pudo copiar';
            }
          );
        });
        return b;
      };

      const mostrar = (texto, acciones, esError) => {
        status.replaceChildren();
        status.classList.toggle('contact__status--error', Boolean(esError));
        status.append(texto);
        if (!acciones.length) return;
        const box = document.createElement('div');
        box.className = 'contact__recovery';
        box.append(...acciones);
        status.append(box);
      };

      // --- Matriz de estados ----------------------------------------------
      // Dos ejes independientes: si la entrega quedo registrada y si WhatsApp
      // llego a abrirse. Nunca se afirma recepcion sin confirmacion del POST.
      if (entregado === true) {
        if (opened) {
          mostrar(
            'Recibimos tus datos. Abrimos WhatsApp para que sigas la conversación ahí.',
            [],
            false
          );
        } else {
          mostrar(
            'Recibimos tus datos. El navegador bloqueó la ventana de WhatsApp, pero tu mensaje ya está registrado.',
            [accionWhatsApp()],
            false
          );
        }
        return;
      }

      if (entregado === false) {
        mostrar(
          'No pudimos registrar el envío. Tu mensaje está listo: mandalo por WhatsApp o por email y te respondemos igual.',
          [accionWhatsApp(), accionEmail(), accionCopiar()],
          true
        );
        return;
      }

      // Sin endpoint configurado: comportamiento original, sin cambios.
      if (opened) {
        mostrar(
          'Abrimos WhatsApp con tus datos cargados. Todavía falta que envíes el mensaje desde ahí.',
          [],
          false
        );
        return;
      }

      mostrar(
        'El navegador bloqueó la ventana de WhatsApp. Tenés tu mensaje listo acá:',
        [accionWhatsApp(), accionEmail(), accionCopiar()],
        false
      );
    });

    // Limpia el error del campo apenas el usuario corrige.
    form.querySelectorAll('input, select, textarea').forEach((input) => {
      input.addEventListener('input', () => {
        if (input.getAttribute('aria-invalid') === 'true') setError(input, '');
      });
    });
  }
</script>
