---
/**
 * ConnectionGap — el problema entre dos capas, no dentro de una.
 *
 * Cada capa del recorrido comercial puede funcionar bien por separado y aun
 * asi el negocio pierde: lo que falta es el enlace. El componente nombra las
 * dos piezas, el sintoma que produce el hueco y que se construye para cerrarlo.
 *
 * El orden importa: primero el cuello de botella de negocio, despues la
 * intervencion tecnica. Nunca al reves.
 */
export interface Gap {
  from: string;
  to: string;
  /** Que se ve desde el negocio cuando el enlace no existe. */
  symptom: string;
  /** La intervencion concreta que cierra el hueco. */
  build: string;
}

export interface Props {
  gaps: Gap[];
}

const { gaps } = Astro.props;
---

<ul class="cg" role="list">
  {
    gaps.map((gap, i) => (
      <li class="cg__item" data-reveal data-reveal-delay={String((i % 3) + 1)}>
        <p class="cg__pair">
          <span class="cg__layer">{gap.from}</span>
          <span class="cg__break">
            <span class="cg__break-mark" aria-hidden="true">
              &#215;
            </span>
            <span class="cg__break-label">sin conexión</span>
          </span>
          <span class="cg__layer">{gap.to}</span>
        </p>

        <p class="cg__symptom">{gap.symptom}</p>

        <p class="cg__build">
          <span class="cg__build-label">Se construye</span>
          {gap.build}
        </p>
      </li>
    ))
  }
</ul>

<style>
  .cg {
    display: grid;
    gap: var(--space-sm);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cg__item {
    padding: var(--space-md);
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .cg__pair {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
  }

  .cg__layer {
    padding: 0.25rem 0.5rem;
    font-family: var(--font-heading);
    font-size: var(--text-2xs);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-primary);
    background: var(--bg-primary);
    border: 1px solid var(--border-active);
    border-radius: var(--radius-sm);
  }

  /* El corte se nombra en palabras ademas del simbolo: una cruz sola no
     comunica a quien usa lector de pantalla. */
  .cg__break {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--danger);
  }

  .cg__break-mark {
    font-size: var(--text-base);
    line-height: 1;
  }

  .cg__break-label {
    font-family: var(--font-heading);
    font-size: var(--text-2xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .cg__symptom {
    margin-top: var(--space-sm);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--text-secondary);
  }

  .cg__build {
    margin-top: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--border);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-primary);
  }

  .cg__build-label {
    display: block;
    margin-bottom: var(--space-3xs);
    font-family: var(--font-heading);
    font-size: var(--text-2xs);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
  }

  @media (min-width: 48rem) {
    .cg {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
