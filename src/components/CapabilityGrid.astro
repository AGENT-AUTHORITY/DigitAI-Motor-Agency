---
/**
 * CapabilityGrid — capacidades como problema, no como catalogo.
 *
 * Rediseno de FASE 3.1: antes se leia como una lista de servicios. Ahora cada
 * fila abre con la PREGUNTA que el cliente ya se hizo, y recien despues
 * aparece la capacidad que la responde. El orden importa: primero el sintoma
 * que el visitante reconoce, despues el nombre de la disciplina.
 *
 * Performance Creative no aparece aca: ya tuvo seccion propia.
 */
export interface Capability {
  /** La pregunta que el visitante ya se hizo. Entra primero. */
  problem: string;
  title: string;
  answer: string;
  items: string[];
}

export interface Props {
  capabilities: Capability[];
}

const { capabilities } = Astro.props;
---

<div class="caps">
  {
    capabilities.map((cap, i) => (
      <article class="cap" data-reveal data-reveal-delay={String((i % 3) + 1)}>
        <p class="cap__problem">{cap.problem}</p>

        <div class="cap__answer">
          <h3 class="cap__title">{cap.title}</h3>
          <p class="cap__copy">{cap.answer}</p>
          <ul class="cap__items" role="list">
            {cap.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </article>
    ))
  }
</div>

<style>
  .caps {
    display: grid;
    border-top: 1px solid var(--border);
  }

  .cap {
    display: grid;
    gap: var(--space-sm);
    padding-block: var(--space-lg);
    border-bottom: 1px solid var(--border);
  }

  /* La pregunta es lo que se lee primero y en la escala mas grande: el
     visitante tiene que reconocerse antes de leer el nombre de la disciplina. */
  .cap__problem {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
    max-width: 26ch;
    text-wrap: balance;
  }

  .cap__answer {
    display: grid;
    gap: var(--space-2xs);
  }

  .cap__title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
  }

  /* Guion que ancla la capacidad a la pregunta. Reemplaza al icono generico. */
  .cap__title::before {
    content: '';
    inline-size: 1.5rem;
    block-size: 2px;
    background: var(--accent);
    flex: none;
  }

  .cap__copy {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    max-width: 48ch;
  }

  .cap__items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs) var(--space-2xs);
    list-style: none;
    margin: var(--space-2xs) 0 0;
    padding: 0;
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .cap__items li {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .cap__items li:not(:last-child)::after {
    content: '·';
    opacity: 0.6;
  }

  @media (min-width: 64rem) {
    .cap {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      align-items: start;
      column-gap: var(--space-2xl);
      padding-block: var(--space-xl);
    }

    .cap__problem {
      font-size: var(--text-2xl);
      max-width: 20ch;
    }
  }
</style>
