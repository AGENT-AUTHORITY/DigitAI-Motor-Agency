---
/**
 * CreativeFlow — el diagrama de Performance Creative.
 *
 * Lenguaje visual propio dentro del mismo design system: la cadena lineal
 * termina en un TEST que bifurca, y esa bifurcacion es el punto entero de la
 * seccion. Sin senal se aprende; con senal se itera y se escala.
 *
 * Toda la informacion esta en texto. El unico SVG es el conector, decorativo.
 */
const STAGES = ['RESEARCH', 'INSIGHT', 'CONCEPT', 'HOOK', 'CREATIVE'];

const VARIABLES = ['Hooks', 'Angles', 'Concepts', 'Formats', 'Offer', 'Message'];
const SIGNALS = ['CTR', 'CPC', 'CVR', 'CPA', 'Lead Quality'];
---

<div class="creative">
  <ol class="creative__chain" role="list">
    {
      STAGES.map((stage, i) => (
        <li class="creative__stage" data-reveal data-reveal-delay={String((i % 3) + 1)}>
          <span class="creative__stage-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="creative__stage-label">{stage}</span>
        </li>
      ))
    }
    <li class="creative__stage creative__stage--test" data-reveal>
      <span class="creative__stage-index" aria-hidden="true">06</span>
      <span class="creative__stage-label">TEST</span>
    </li>
  </ol>

  <div class="creative__branches">
    <div class="creative__branch creative__branch--learn" data-reveal>
      <p class="creative__branch-tag">NO SIGNAL</p>
      <p class="creative__branch-title">Learn</p>
      <p class="creative__branch-copy">
        El concepto no funcionó, pero el test sí: descarta una hipótesis y
        acota dónde buscar la siguiente.
      </p>
    </div>

    <div class="creative__branch creative__branch--scale" data-reveal data-reveal-delay="1">
      <p class="creative__branch-tag">SIGNAL</p>
      <p class="creative__branch-title">Iterate → Scale</p>
      <p class="creative__branch-copy">
        Con un mensaje que ya mostró señal no se reinicia desde cero: se itera
        en nuevos hooks, formatos y versiones.
      </p>
    </div>
  </div>

  <div class="creative__meta">
    <div class="creative__meta-group">
      <p class="creative__meta-title">Qué probamos</p>
      <ul class="creative__chips" role="list">
        {VARIABLES.map((v) => <li class="chip">{v}</li>)}
      </ul>
    </div>
    <div class="creative__meta-group">
      <p class="creative__meta-title">Contra qué lo leemos</p>
      <ul class="creative__chips" role="list">
        {SIGNALS.map((s) => <li class="chip chip--accent">{s}</li>)}
      </ul>
    </div>
  </div>
</div>

<style>
  .creative {
    display: grid;
    gap: var(--space-lg);
  }

  .creative__chain {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .creative__stage {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding: var(--space-xs) var(--space-sm);
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }

  /* El TEST es el nodo pivote: de aca sale la bifurcacion. */
  .creative__stage--test {
    grid-column: 1 / -1;
    background: var(--accent-soft);
    border-color: var(--accent-line);
  }

  .creative__stage-index {
    font-family: var(--font-heading);
    font-size: var(--text-2xs);
    font-weight: var(--weight-bold);
    color: var(--text-muted);
  }

  .creative__stage--test .creative__stage-index {
    color: var(--accent);
  }

  .creative__stage-label {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-wide);
    color: var(--text-primary);
  }

  .creative__branches {
    display: grid;
    gap: var(--space-sm);
  }

  .creative__branch {
    position: relative;
    padding: var(--space-md);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--highlight-top);
  }

  /* Borde superior de color: la unica senal cromatica que separa las dos
     salidas. Verde solo del lado que efectivamente es resultado positivo. */
  .creative__branch::before {
    content: '';
    position: absolute;
    inset-block-start: -1px;
    inset-inline-start: var(--space-md);
    inline-size: 2.5rem;
    block-size: 2px;
  }

  .creative__branch--learn::before { background: var(--warning); }
  .creative__branch--scale::before { background: var(--positive); }

  .creative__branch-tag {
    font-family: var(--font-heading);
    font-size: var(--text-2xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-eyebrow);
  }

  .creative__branch--learn .creative__branch-tag { color: var(--warning); }
  .creative__branch--scale .creative__branch-tag { color: var(--positive); }

  .creative__branch-title {
    margin-top: var(--space-2xs);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
  }

  .creative__branch-copy {
    margin-top: var(--space-2xs);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .creative__meta {
    display: grid;
    gap: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
  }

  .creative__meta-title {
    margin-bottom: var(--space-2xs);
    font-family: var(--font-heading);
    font-size: var(--text-2xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .creative__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 40rem) {
    .creative__branches { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .creative__meta { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 64rem) {
    .creative__chain { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .creative__stage--test { grid-column: auto; }
  }
</style>
