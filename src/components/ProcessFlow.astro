---
/**
 * ProcessFlow — los 7 pasos del sistema de trabajo.
 *
 * Rediseno de FASE 3.1: antes eran 7 cards apiladas y generaban demasiado
 * scroll. Ahora es un flow con riel.
 *
 * Desktop: Research ocupa la fila superior completa (es el paso que define el
 * posicionamiento) y los 6 restantes van en una sola fila de 6 columnas con
 * riel horizontal. Dos filas en total.
 * Mobile: columna con riel vertical y numeros sobre la linea.
 *
 * Sin cards para los pasos 02-07: el numero, el titulo y una linea de texto
 * alcanzan. Menos superficie, mismo contenido.
 */
export interface Step {
  number: string;
  title: string;
  description: string;
  detail?: string[];
}

export interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
const [lead, ...rest] = steps;
---

<div class="pf">
  <article class="pf__lead" data-reveal>
    <div class="pf__lead-head">
      <span class="pf__number pf__number--lead">{lead.number}</span>
      <h3 class="pf__title pf__title--lead">{lead.title}</h3>
    </div>
    <p class="pf__lead-desc">{lead.description}</p>
    {
      lead.detail && (
        <ul class="pf__detail" role="list">
          {lead.detail.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }
  </article>

  <ol class="pf__rail" role="list">
    {
      rest.map((step, i) => (
        <li class="pf__step" data-reveal data-reveal-delay={String((i % 3) + 1)}>
          <div class="pf__marker" aria-hidden="true">
            <span class="pf__dot" />
            <span class="pf__line" />
          </div>
          <span class="pf__number">{step.number}</span>
          <h3 class="pf__title">{step.title}</h3>
          <p class="pf__desc">{step.description}</p>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .pf {
    display: grid;
    gap: var(--space-lg);
  }

  /* --- Paso 01: el unico con superficie ------------------------------------ */

  .pf__lead {
    padding-inline-start: var(--space-md);
    border-inline-start: 2px solid var(--accent);
  }

  .pf__lead-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
  }

  .pf__lead-desc {
    margin-top: var(--space-2xs);
    max-width: 64ch;
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .pf__detail {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs) var(--space-2xs);
    list-style: none;
    margin: var(--space-sm) 0 0;
    padding: 0;
  }

  .pf__detail li {
    padding: 0.1875rem 0.5rem;
    font-size: var(--text-2xs);
    line-height: 1.4;
    color: var(--text-muted);
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
  }

  /* --- Pasos 02-07: sin superficie, solo riel ------------------------------ */

  .pf__rail {
    display: grid;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pf__step {
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    grid-template-areas:
      'marker number'
      'marker title'
      'marker desc';
    column-gap: var(--space-sm);
    padding-bottom: var(--space-md);
  }

  .pf__marker {
    grid-area: marker;
    position: relative;
    display: flex;
    justify-content: center;
    padding-top: 0.25rem;
  }

  .pf__dot {
    inline-size: 8px;
    block-size: 8px;
    border-radius: var(--radius-full);
    background: var(--bg-primary);
    border: 2px solid var(--accent);
    z-index: 1;
  }

  .pf__line {
    position: absolute;
    inset-block-start: 0.9rem;
    inline-size: 1px;
    block-size: calc(100% + var(--space-md));
    background: linear-gradient(var(--border-active), var(--border));
  }

  .pf__step:last-child .pf__line {
    display: none;
  }

  .pf__number {
    grid-area: number;
    font-family: var(--font-heading);
    font-size: var(--text-2xs);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-wide);
    color: var(--accent);
  }

  .pf__number--lead {
    font-size: var(--text-xs);
  }

  .pf__title {
    grid-area: title;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .pf__title--lead {
    font-size: var(--text-xl);
    text-transform: none;
    letter-spacing: var(--tracking-tight);
  }

  .pf__desc {
    grid-area: desc;
    margin-top: var(--space-3xs);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-muted);
  }

  /* --- Desktop: el riel se acuesta ----------------------------------------- */

  @media (min-width: 64rem) {
    .pf {
      gap: var(--space-lg);
    }

    .pf__lead {
      display: grid;
      grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
      align-items: start;
      column-gap: var(--space-xl);
    }

    .pf__lead-desc {
      margin-top: 0;
    }

    .pf__detail {
      grid-column: 2;
      margin-top: var(--space-sm);
    }

    .pf__rail {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      column-gap: var(--space-sm);
    }

    .pf__step {
      grid-template-columns: 1fr;
      grid-template-areas:
        'marker'
        'number'
        'title'
        'desc';
      padding-bottom: 0;
    }

    .pf__marker {
      justify-content: flex-start;
      padding-top: 0;
      padding-bottom: var(--space-sm);
    }

    .pf__line {
      inset-block-start: 3px;
      inset-inline-start: 0.625rem;
      inline-size: calc(100% + var(--space-sm));
      block-size: 1px;
      background: linear-gradient(90deg, var(--border-active), var(--border));
    }

    .pf__desc {
      font-size: var(--text-xs);
      line-height: 1.45;
    }
  }
</style>
