---
import MetricCard from './MetricCard.astro';

/**
 * EvidenceCase — el caso de auditoria.
 *
 * Reglas duras aplicadas aca (docs/COPY.md):
 * - El cliente NO se nombra. Es "Performance Audit · Energy B2C/B2B".
 * - No se implica relacion de agencia.
 * - Verbos de hallazgo unicamente: analyzed / identified / detected /
 *   recommended. Nunca generated / saved / increased / improved.
 * - Toda cifra lleva su origen: son datos de una cuenta AUDITADA.
 */
export interface Props {
  title: string;
  context: string;
  period: string;
  metrics: { value: string; label: string; status?: 'neutral' | 'positive' | 'warning' | 'attention' }[];
  findingLead: string;
  findingDetail: string;
  secondary: { label: string; value: string }[];
  secondaryTitle: string;
  narrative: string;
  recommended: string[];
  closing: string;
  sourceNote: string;
}

const {
  title,
  context,
  period,
  metrics,
  findingLead,
  findingDetail,
  secondary,
  secondaryTitle,
  narrative,
  recommended,
  closing,
  sourceNote,
} = Astro.props;
---

<div class="evidence">
  <div class="evidence__head" data-reveal>
    <div>
      <h3 class="evidence__title">{title}</h3>
      <p class="evidence__context">{context}</p>
    </div>
    <p class="chip evidence__period">{period}</p>
  </div>

  <div class="evidence__metrics">
    {metrics.map((m) => <MetricCard value={m.value} label={m.label} status={m.status} />)}
  </div>

  <p class="source-note evidence__source">{sourceNote}</p>

  <div class="evidence__body">
    <div class="evidence__finding" data-reveal>
      <p class="evidence__finding-lead">{findingLead}</p>
      <p class="evidence__finding-detail">{findingDetail}</p>
      <p class="evidence__narrative">{narrative}</p>
    </div>

    <div class="evidence__side" data-reveal data-reveal-delay="1">
      <div class="evidence__secondary">
        <p class="evidence__side-title">{secondaryTitle}</p>
        <dl class="evidence__stats">
          {
            secondary.map((s) => (
              <div class="evidence__stat">
                <dt>{s.label}</dt>
                <dd data-numeric>{s.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="evidence__recommended">
        <p class="evidence__side-title">Recomendado</p>
        <ul class="evidence__list" role="list">
          {recommended.map((r) => <li>{r}</li>)}
        </ul>
      </div>
    </div>
  </div>

  <p class="evidence__closing" data-reveal>{closing}</p>
</div>

<style>
  .evidence {
    display: grid;
    gap: var(--space-lg);
  }

  .evidence__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--border);
  }

  .evidence__title {
    font-family: var(--font-heading);
    font-size: var(--text-2xs);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
  }

  .evidence__context {
    margin-top: var(--space-3xs);
    font-size: var(--text-base);
    color: var(--text-secondary);
  }

  .evidence__period {
    flex: none;
  }

  .evidence__metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2xs);
  }

  .evidence__source {
    margin-top: calc(var(--space-md) * -1);
  }

  .evidence__body {
    display: grid;
    gap: var(--space-lg);
  }

  /* El hallazgo es el titular real de la seccion, no las metricas de volumen.
     Por eso va a escala de heading y las cifras de contexto quedan al lado. */
  .evidence__finding-lead {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--weight-extrabold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
    max-width: 26ch;
  }

  .evidence__finding-detail {
    margin-top: var(--space-sm);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--warning);
  }

  .evidence__narrative {
    margin-top: var(--space-md);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    max-width: 52ch;
  }

  .evidence__side {
    display: grid;
    gap: var(--space-md);
    align-content: start;
  }

  .evidence__secondary,
  .evidence__recommended {
    padding: var(--space-md);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--highlight-top);
  }

  .evidence__side-title {
    margin-bottom: var(--space-2xs);
    font-family: var(--font-heading);
    font-size: var(--text-2xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .evidence__stats {
    display: grid;
    gap: var(--space-3xs);
    margin: 0;
  }

  .evidence__stat {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-block: 0.3125rem;
    border-bottom: 1px solid var(--border);
    font-size: var(--text-sm);
  }

  .evidence__stat:last-child {
    border-bottom: 0;
  }

  .evidence__stat dt {
    color: var(--text-muted);
  }

  .evidence__stat dd {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
  }

  .evidence__list {
    display: grid;
    gap: var(--space-3xs);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .evidence__list li {
    display: grid;
    grid-template-columns: 0.75rem 1fr;
    gap: var(--space-2xs);
  }

  .evidence__list li::before {
    content: '';
    inline-size: 5px;
    block-size: 5px;
    margin-top: 0.55em;
    border-radius: var(--radius-full);
    background: var(--accent);
  }

  .evidence__closing {
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--weight-extrabold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text-primary);
    max-width: 24ch;
  }

  @media (min-width: 40rem) {
    .evidence__metrics {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-md);
    }
  }

  @media (min-width: 64rem) {
    .evidence__body {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      column-gap: var(--space-2xl);
    }
  }
</style>
