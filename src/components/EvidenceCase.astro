---
import MetricCard from './MetricCard.astro';

/**
 * EvidenceCase — el caso de auditoria.
 *
 * Reglas duras aplicadas aca (docs/COPY.md):
 * - El cliente NO se nombra. Es "Performance Audit · Energy B2C/B2B".
 * - No se implica relacion de agencia.
 * - Verbos de hallazgo unicamente: analyzed / identified / detected /
 *   recommended. Nunca generated / saved / increased / improved.
 * - Toda cifra lleva su origen: son datos de una cuenta AUDITADA.
 *
 * JERARQUIA (el orden es el argumento):
 * el bloque abre con la conclusion, no con el metodo. Primero se afirma que el
 * problema era el sistema, despues las cifras que lo sostienen, y recien
 * entonces el hallazgo. Antes la narrativa larga iba antes que las senales, y
 * el lector llegaba a los numeros ya cansado.
 *
 * El hallazgo es el unico elemento a escala de display: es lo que hay que
 * recordar si se lee una sola linea de toda la seccion.
 */
export interface Props {
  /** Identidad del caso. Nunca el nombre del cliente. */
  title: string;
  /** Alcance del trabajo. */
  scope: string;
  /** La conclusion. Encabeza el hallazgo, despues de las cifras que lo sostienen. */
  findingTitle: string;
  metrics: {
    value: string;
    label: string;
    /** Aclaracion bajo el label. Obligatoria cuando el numero podria leerse
     *  como un resultado producido por digitAI Motor. */
    context?: string;
    status?: 'neutral' | 'positive' | 'warning' | 'attention';
    /** Apagar en valores aproximados. */
    countUp?: boolean;
  }[];
  sourceNote: string;
  /** Detalle del hallazgo. Unico elemento a escala de display del bloque. */
  finding: string;
  signalsTitle: string;
  signals: { label: string; value: string }[];
  recommendedTitle: string;
  recommended: string[];
  closing: string;
  /** Importes del caso. Trazabilidad, nunca titular. */
  traceability?: string;
}

const {
  title,
  scope,
  findingTitle,
  metrics,
  sourceNote,
  finding,
  signalsTitle,
  signals,
  recommendedTitle,
  recommended,
  closing,
  traceability,
} = Astro.props;
---

<div class="evidence">
  <div class="evidence__head" data-reveal>
    <p class="evidence__case">{title}</p>
    <p class="chip evidence__scope">{scope}</p>
  </div>

  <div class="evidence__metrics">
    {
      metrics.map((m) => (
        <MetricCard
          value={m.value}
          label={m.label}
          context={m.context}
          status={m.status}
          countUp={m.countUp !== false}
        />
      ))
    }
  </div>

  <p class="source-note evidence__source">{sourceNote}</p>

  {/* El hallazgo va solo, a ancho de lectura y sin superficie. Meterlo en una
      tarjeta lo habria igualado a las senales y a las recomendaciones, que son
      soporte. Esto es la conclusion, y llega despues de las cifras que la
      sostienen: primero la evidencia, despues la lectura. */}
  <div class="evidence__finding" data-reveal>
    <h3 class="evidence__finding-title">{findingTitle}</h3>
    <p class="evidence__finding-detail">{finding}</p>
  </div>

  <div class="evidence__panels">
    <div class="evidence__panel evidence__panel--signals" data-reveal>
      <p class="evidence__panel-title">{signalsTitle}</p>
      <dl class="evidence__signals">
        {
          signals.map((s) => (
            <div class="evidence__signal">
              <dt data-numeric>{s.value}</dt>
              <dd>{s.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="evidence__panel" data-reveal data-reveal-delay="1">
      <p class="evidence__panel-title">{recommendedTitle}</p>
      <ul class="evidence__list" role="list">
        {recommended.map((r) => <li>{r}</li>)}
      </ul>
    </div>
  </div>

  <p class="evidence__closing" data-reveal>{closing}</p>

  {traceability && <p class="source-note evidence__trace">{traceability}</p>}
</div>

<style>
  .evidence {
    display: grid;
    gap: var(--space-lg);
  }

  .evidence__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--border);
  }

  .evidence__case {
    font-family: var(--font-heading);
    font-size: var(--text-2xs);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
  }

  .evidence__scope {
    flex: none;
  }

  .evidence__metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2xs);
  }

  .evidence__source {
    margin-top: calc(var(--space-md) * -1);
  }

  /* Escala de display y una linea de acento a la izquierda: es el unico
     elemento del bloque que se lee desde lejos. Sin superficie a proposito
     — una tarjeta lo habria bajado al nivel de los paneles de soporte. */
  .evidence__finding {
    padding-left: var(--space-md);
    border-left: 2px solid var(--accent);
    max-width: 52ch;
  }

  .evidence__finding-title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--weight-extrabold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
    max-width: 20ch;
  }

  .evidence__finding-detail {
    margin-top: var(--space-sm);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .evidence__panels {
    display: grid;
    gap: var(--space-md);
  }

  .evidence__panel {
    padding: var(--space-md);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--highlight-top);
  }

  .evidence__panel-title {
    margin-bottom: var(--space-sm);
    font-family: var(--font-heading);
    font-size: var(--text-2xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* Las senales pasan de filas de texto con la cifra al final a una grilla con
     la cifra adelante y grande. El numero es el hallazgo; la etiqueta lo
     explica. Al reves habia que leer la frase entera para llegar al dato. */
  .evidence__signals {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md) var(--space-sm);
    margin: 0;
  }

  .evidence__signal dt {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--weight-extrabold);
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }

  .evidence__signal dd {
    margin: var(--space-3xs) 0 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-muted);
  }

  .evidence__list {
    display: grid;
    gap: var(--space-2xs);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-secondary);
  }

  .evidence__list li {
    display: grid;
    grid-template-columns: 0.75rem 1fr;
    gap: var(--space-2xs);
  }

  .evidence__list li::before {
    content: '';
    inline-size: 5px;
    block-size: 5px;
    margin-top: 0.55em;
    border-radius: var(--radius-full);
    background: var(--accent);
  }

  .evidence__closing {
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--weight-extrabold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-display);
    color: var(--text-primary);
    max-width: 24ch;
  }

  /* Pie de todo el bloque. Es letra chica de respaldo, no un dato de la
     lectura principal: por eso va despues del cierre y sin superficie. */
  .evidence__trace {
    margin-top: var(--space-xs);
    max-width: 78ch;
  }

  @media (min-width: 40rem) {
    .evidence__metrics {
      gap: var(--space-md);
    }
  }

  /* 4 columnas a 64rem. Bajo ese ancho quedan 2, que a 40rem daba cards de
     ~130px. El ajuste de tamano para valores largos lo maneja MetricCard con
     un container query sobre el ancho real de la card. */
  @media (min-width: 64rem) {
    .evidence__metrics {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    /* El hallazgo escala y el titulo del caso no. Con los dos en --text-3xl
       el H2 de la seccion, el titulo del caso y el hallazgo median lo mismo:
       tres pesos iguales no son jerarquia, son una lista. El hallazgo es lo
       unico que hay que recordar si se lee una sola linea. */
    .evidence__finding {
      padding-left: var(--space-lg);
    }

    .evidence__finding-title {
      font-size: var(--text-3xl);
    }

    /* Senales pesa mas que recomendaciones: son la evidencia, no el plan. */
    .evidence__panels {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      column-gap: var(--space-xl);
    }
  }
</style>
