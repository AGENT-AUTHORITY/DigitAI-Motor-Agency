---
/**
 * QuickFixMatrix — modalidad de entrada, no un septimo pilar.
 *
 * Sin precios, sin modal, sin lenguaje de tarifa barata. Es acceso rapido a
 * criterio senior sobre un problema acotado.
 */
export interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ul class="qf" role="list">
  {
    items.map((item, i) => (
      <li class="qf__item" data-reveal data-reveal-delay={String((i % 3) + 1)}>
        <span class="qf__mark" aria-hidden="true" />
        {item}
      </li>
    ))
  }
</ul>

<style>
  .qf {
    display: grid;
    /* Columnas fijas, no auto-fill: 16 items sobre un auto-fill dejaba una
       ultima fila con 2 celdas llenas y 5 vacias. 2 y 4 columnas dividen 16
       exacto, asi la matriz cierra siempre. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    list-style: none;
    margin: 0;
    padding: 0;
    /* Grilla de 1px de gap sobre fondo de borde: las celdas se leen como una
       matriz continua en vez de 16 cards sueltas. */
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .qf__item {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-sm) var(--space-xs);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--text-secondary);
    background: var(--bg-secondary);
    transition: background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .qf__item:hover {
    background: var(--surface-hover);
    color: var(--text-primary);
  }

  .qf__mark {
    flex: none;
    inline-size: 4px;
    block-size: 4px;
    border-radius: var(--radius-full);
    background: var(--border-active);
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .qf__item:hover .qf__mark {
    background: var(--accent);
  }

  @media (min-width: 48rem) {
    .qf {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
