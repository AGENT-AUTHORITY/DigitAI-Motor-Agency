---
import Button from './Button.astro';

/**
 * Hero.
 *
 * `title` acepta un array para controlar el corte de linea sin recurrir a
 * <br> en el contenido: cada entrada es una linea logica que colapsa a un
 * parrafo continuo cuando no entra.
 *
 * El slot `media` queda para el visual. El video legacy de 12.5 MB no se
 * reutiliza; cuando exista hero-growth.webm entra por aca sin tocar el
 * componente. Ver docs/BRAND.md.
 */
export interface Props {
  eyebrow: string;
  title: string | string[];
  subtitle: string;
  supporting?: string;
  primaryCta: { label: string; href: string; trackingEvent?: string };
  secondaryCta?: { label: string; href: string; trackingEvent?: string };
  capabilities?: string[];
  asH1?: boolean;
}

const {
  eyebrow,
  title,
  subtitle,
  supporting,
  primaryCta,
  secondaryCta,
  capabilities = [],
  asH1 = true,
} = Astro.props;

const Heading = asH1 ? 'h1' : 'h2';
const lines = Array.isArray(title) ? title : [title];
const hasMedia = Astro.slots.has('media');
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__field" aria-hidden="true"></div>

  <div class:list={['container', 'hero__inner', hasMedia && 'hero__inner--split']}>
    <div class="hero__content">
      <p class="eyebrow eyebrow--dot hero__eyebrow">{eyebrow}</p>

      <Heading id="hero-title" class="hero__title">
        {lines.map((line) => <span class="hero__line">{line}</span>)}
      </Heading>

      <p class="hero__subtitle">{subtitle}</p>

      {supporting && <p class="hero__supporting">{supporting}</p>}

      <div class="hero__actions">
        <Button
          label={primaryCta.label}
          href={primaryCta.href}
          size="lg"
          arrow
          trackingEvent={primaryCta.trackingEvent ?? 'click_primary_cta'}
          trackingContext="hero"
        />
        {
          secondaryCta && (
            <Button
              label={secondaryCta.label}
              href={secondaryCta.href}
              variant="secondary"
              size="lg"
              trackingEvent={secondaryCta.trackingEvent ?? 'click_secondary_cta'}
              trackingContext="hero"
            />
          )
        }
      </div>
    </div>

    {hasMedia && <div class="hero__media"><slot name="media" /></div>}

    {
      capabilities.length > 0 && (
        <ul class="capability-list hero__capabilities" role="list">
          {capabilities.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: var(--space-section-lg) var(--space-section);
    overflow: hidden;
    isolation: isolate;
  }

  /* Fondo: grilla tenue + halo azul desplazado del centro. CSS puro, 0 KB de
     red. Reemplaza el mp4 de 12.5 MB y las 4 PNG decorativas de la V1. */
  .hero__field {
    position: absolute;
    inset: -20% -10% auto;
    block-size: 130%;
    z-index: -1;
    background-image:
      radial-gradient(42rem 30rem at 68% 12%, rgba(35, 136, 255, 0.16), transparent 62%),
      radial-gradient(28rem 22rem at 12% 4%, rgba(35, 136, 255, 0.07), transparent 60%),
      linear-gradient(rgba(35, 136, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(35, 136, 255, 0.045) 1px, transparent 1px);
    background-size: 100% 100%, 100% 100%, 72px 72px, 72px 72px;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 42%, transparent 88%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 42%, transparent 88%);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-xl);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* Alineado a la izquierda: el hero centrado con blob es justamente el
       patron de template a evitar. */
  }

  .hero__eyebrow {
    margin-bottom: var(--space-md);
  }

  .hero__title {
    font-size: var(--text-display);
    max-width: 20ch;
    margin-bottom: var(--space-md);
  }

  /* Cada linea logica en su propio bloque. Sin <br> en el contenido: si no
     entra, colapsa sola. */
  .hero__line {
    display: block;
  }

  .hero__line + .hero__line {
    color: var(--text-secondary);
  }

  .hero__subtitle {
    max-width: 48ch;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .hero__supporting {
    margin-top: var(--space-sm);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    color: var(--text-muted);
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    width: 100%;
    margin-top: var(--space-xl);
  }

  .hero__capabilities {
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
    width: 100%;
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  @media (min-width: 30rem) {
    .hero__actions {
      flex-direction: row;
      flex-wrap: wrap;
      width: auto;
    }
  }

  @media (min-width: 64rem) {
    .hero__inner--split {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      align-items: center;
      column-gap: var(--space-2xl);
    }

    .hero__inner--split .hero__capabilities {
      grid-column: 1 / -1;
    }

    .hero__title {
      max-width: 19ch;
    }

    .hero__capabilities {
      font-size: var(--text-sm);
    }
  }
</style>
