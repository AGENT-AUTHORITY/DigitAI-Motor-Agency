---
import { FOOTER_NAV, SITE } from '../data/navigation';

const year = new Date().getFullYear();
// Los grupos sin links utilizables no se renderizan. Evita columnas vacias
// o enlaces a "#" mientras faltan las URLs reales de redes.
const groups = FOOTER_NAV.map((group) => ({
  ...group,
  links: group.links.filter((link) => link.href !== ''),
})).filter((group) => group.links.length > 0);
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a class="site-footer__lockup" href="/">
          <img src="/assets/logo.svg" alt="" width="90" height="84" aria-hidden="true" />
          <span class="site-footer__wordmark">digitAI motor</span>
        </a>
        <p class="site-footer__tagline">{SITE.tagline}</p>
      </div>

      <div class="site-footer__nav">
        {
          groups.map((group) => (
            <nav class="footer-group" aria-label={group.title}>
              <h2 class="footer-group__title">{group.title}</h2>
              <ul class="footer-group__list" role="list">
                {group.links.map((link) => {
                  const external = /^https?:\/\//.test(link.href);
                  return (
                    <li>
                      <a
                        class="footer-group__link"
                        href={link.href}
                        {...(external
                          ? { target: '_blank', rel: 'noopener noreferrer' }
                          : {})}
                      >
                        {link.label}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>

    <hr class="section-rule" />

    <div class="site-footer__bottom">
      <p class="site-footer__geo">
        {SITE.locality} · {SITE.region} · {SITE.country}
        <span class="site-footer__geo-sep" aria-hidden="true">—</span>
        {SITE.coverage}
      </p>
      <p class="site-footer__legal">
        &copy; {year} {SITE.legalName}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-2xl) var(--space-xl);
    background: var(--bg-secondary);
    border-top: 1px solid var(--border);
  }

  .site-footer__top {
    display: grid;
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  .site-footer__lockup {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    text-decoration: none;
  }

  .site-footer__brand img {
    block-size: 28px;
    inline-size: auto;
  }

  .site-footer__wordmark {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
  }

  .site-footer__tagline {
    margin-top: var(--space-xs);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted-aa);
  }

  .site-footer__nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    gap: var(--space-lg);
  }

  .footer-group__title {
    font-size: var(--text-2xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-primary);
    margin-bottom: var(--space-sm);
  }

  .footer-group__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-group__link {
    display: inline-block;
    /* Medido en Chrome a 375px: con 0.1875rem el link quedaba en 29px de
       alto. Pasa el minimo AA de WCAG 2.5.8 (24px) pero no la recomendacion
       de 44px. Con 0.625rem queda en 43px de alto y 47px de paso. */
    padding-block: 0.625rem;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer-group__link:hover {
    color: var(--text-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs);
    padding-top: var(--space-lg);
    font-size: var(--text-xs);
    color: var(--text-muted-aa);
  }

  .site-footer__geo-sep {
    margin-inline: var(--space-3xs);
  }

  @media (min-width: 48rem) {
    .site-footer__top {
      grid-template-columns: minmax(12rem, 1fr) 2.4fr;
      gap: var(--space-2xl);
    }
  }
</style>
